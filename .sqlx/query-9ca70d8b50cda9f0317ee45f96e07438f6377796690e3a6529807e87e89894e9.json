  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            si.id,\n            si.product_id,\n            p.name as \"product_name!\",\n            si.quantity,\n            si.selling_price,\n            si.original_price,\n            si.cost_price,\n            si.created_at\n        FROM sale_items si\n        JOIN products p ON p.id = si.product_id\n        JOIN orders o ON o.sale_id = si.sale_id\n        WHERE o.id = $1\n        ",
