{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            product_id,\n            p.name as product_name,\n            SUM(quantity_remaining)::int AS \"quantity_in_stock!\"\n        FROM inventory\n        JOIN products p on p.id = product_id\n        GROUP BY product_id, product_name\n        ORDER BY SUM(quantity_remaining) ASC\n        LIMIT $1\n        ",
