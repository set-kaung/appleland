{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT users.id, users.username, uc.address_line_1, uc.phone_number\n        FROM users\n        LEFT JOIN LATERAL (\n            SELECT address_line_1, phone_number\n            FROM user_contact\n            WHERE user_id = users.id\n            ORDER BY created_at ASC, id ASC\n            LIMIT 1\n        ) uc ON TRUE\n        ORDER BY users.created_at DESC\n        LIMIT $1 OFFSET $2\n        ",
