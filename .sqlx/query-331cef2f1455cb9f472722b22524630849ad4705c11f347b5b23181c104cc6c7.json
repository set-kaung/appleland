  "query": "\n        SELECT id, product_id, quantity_received, quantity_remaining, unit_cost, created_by, updated_by, created_at, updated_at\n        FROM inventory\n        WHERE product_id = ANY($1) AND quantity_remaining > 0\n        ORDER BY product_id, created_at ASC, id ASC\n        ",
