  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            o.id as \"id!\",\n            o.delivery_status as \"delivery_status!\",\n            o.created_at as \"created_at!\",\n            s.total_amount as \"total_amount!\"\n        FROM orders o\n        JOIN sales s ON s.id = o.sale_id\n        WHERE o.created_by = $1\n        ORDER BY o.created_at DESC, o.id ASC\n        LIMIT $2 OFFSET $3\n        ",
