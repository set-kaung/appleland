{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.total_amount, s.created_at, s.is_instore as \"is_instore_sale\"\n        FROM user_sales us\n        JOIN sales s ON s.id = us.sale_id\n        WHERE us.user_id = $1\n        ORDER BY s.created_at DESC, s.id DESC\n        ",
